{
  "manifest_version": 3,
  "name": "TempMail Tester",
  "version": "1.0",
  "description": "A Chrome extension for testing temporary email services",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://mail.tm/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TempMail Tester"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}